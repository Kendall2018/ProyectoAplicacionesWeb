<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- ===================================================== -->
    <!-- SPRING BOOT -->
    <!-- ===================================================== -->

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>


    <!-- ===================================================== -->
    <!-- INFORMACIÓN DEL PROYECTO -->
    <!-- ===================================================== -->

    <groupId>com.mycompany</groupId>

    <artifactId>ProyectoAplicacionesWeb</artifactId>

    <version>0.0.1-SNAPSHOT</version>

    <name>ProyectoAplicacionesWeb</name>

    <description>
        Proyecto aplicaciones web
    </description>


    <!-- ===================================================== -->
    <!-- PROPIEDADES -->
    <!-- ===================================================== -->

    <properties>

        <java.version>21</java.version>

        <start-class>
            com.mycompany.ProyectoAplicacionesWeb.ProyectoAplicacionesWebApplication
        </start-class>

    </properties>


    <!-- ===================================================== -->
    <!-- DEPENDENCIAS -->
    <!-- ===================================================== -->

    <dependencies>


        <!-- ================================================= -->
        <!-- SPRING SECURITY -->
        <!-- ================================================= -->

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>


        <!-- ================================================= -->
        <!-- THYMELEAF -->
        <!-- ================================================= -->

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>


        <!-- ================================================= -->
        <!-- SPRING MVC -->
        <!-- ================================================= -->

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>


        <!-- ================================================= -->
        <!-- THYMELEAF + SPRING SECURITY -->
        <!-- ================================================= -->

        <dependency>
            <groupId>org.thymeleaf.extras</groupId>
            <artifactId>thymeleaf-extras-springsecurity6</artifactId>
        </dependency>


        <!-- ================================================= -->
        <!-- DEVTOOLS -->
        <!-- ================================================= -->

        <dependency>

            <groupId>org.springframework.boot</groupId>

            <artifactId>
                spring-boot-devtools
            </artifactId>

            <scope>runtime</scope>

            <optional>true</optional>

        </dependency>


        <!-- ================================================= -->
        <!-- LOMBOK -->
        <!-- ================================================= -->

        <dependency>

            <groupId>
                org.projectlombok
            </groupId>

            <artifactId>
                lombok
            </artifactId>

            <scope>
                provided
            </scope>

        </dependency>


        <!-- ================================================= -->
        <!-- ENVÍO DE CORREOS -->
        <!-- ================================================= -->

        <dependency>

            <groupId>
                org.springframework.boot
            </groupId>

            <artifactId>
                spring-boot-starter-mail
            </artifactId>

        </dependency>


        <!-- ================================================= -->
        <!-- PRUEBAS -->
        <!-- ================================================= -->

        <dependency>

            <groupId>
                org.springframework.boot
            </groupId>

            <artifactId>
                spring-boot-starter-security-test
            </artifactId>

            <scope>
                test
            </scope>

        </dependency>


        <dependency>

            <groupId>
                org.springframework.boot
            </groupId>

            <artifactId>
                spring-boot-starter-thymeleaf-test
            </artifactId>

            <scope>
                test
            </scope>

        </dependency>


        <dependency>

            <groupId>
                org.springframework.boot
            </groupId>

            <artifactId>
                spring-boot-starter-webmvc-test
            </artifactId>

            <scope>
                test
            </scope>

        </dependency>


        <!-- ================================================= -->
        <!-- WEBJARS -->
        <!-- ================================================= -->

        <dependency>

            <groupId>
                org.webjars
            </groupId>

            <artifactId>
                bootstrap
            </artifactId>

            <version>
                5.3.7
            </version>

        </dependency>


        <dependency>

            <groupId>
                org.webjars
            </groupId>

            <artifactId>
                font-awesome
            </artifactId>

            <version>
                7.0.0
            </version>

        </dependency>


        <dependency>

            <groupId>
                org.webjars
            </groupId>

            <artifactId>
                jquery
            </artifactId>

            <version>
                3.7.1
            </version>

        </dependency>


        <dependency>

            <groupId>
                org.webjars
            </groupId>

            <artifactId>
                popper.js
            </artifactId>

            <version>
                2.11.7
            </version>

        </dependency>


        <dependency>

            <groupId>
                org.webjars
            </groupId>

            <artifactId>
                webjars-locator
            </artifactId>

            <version>
                0.52
            </version>

        </dependency>


        <dependency>

            <groupId>
                org.webjars
            </groupId>

            <artifactId>
                webjars-locator-lite
            </artifactId>

        </dependency>


        <!-- ================================================= -->
        <!-- MYSQL -->
        <!-- ================================================= -->

        <dependency>

            <groupId>
                com.mysql
            </groupId>

            <artifactId>
                mysql-connector-j
            </artifactId>

            <scope>
                runtime
            </scope>

        </dependency>


        <!-- ================================================= -->
        <!-- SPRING DATA JPA -->
        <!-- ================================================= -->

        <dependency>

            <groupId>
                org.springframework.boot
            </groupId>

            <artifactId>
                spring-boot-starter-data-jpa
            </artifactId>

        </dependency>


        <!-- ================================================= -->
        <!-- VALIDACIONES -->
        <!-- ================================================= -->

        <dependency>

            <groupId>
                org.springframework.boot
            </groupId>

            <artifactId>
                spring-boot-starter-validation
            </artifactId>

        </dependency>


        <!-- ================================================= -->
        <!-- FIREBASE -->
        <!-- ================================================= -->

        <dependency>

            <groupId>
                com.google.firebase
            </groupId>

            <artifactId>
                firebase-admin
            </artifactId>

            <version>
                9.7.0
            </version>

        </dependency>


        <!-- ================================================= -->
        <!-- HIBERNATE VALIDATOR -->
        <!-- ================================================= -->

        <dependency>

            <groupId>
                org.hibernate.validator
            </groupId>

            <artifactId>
                hibernate-validator
            </artifactId>

        </dependency>


    </dependencies>


    <!-- ===================================================== -->
    <!-- BUILD -->
    <!-- ===================================================== -->

    <build>

        <plugins>


            <!-- ================================================= -->
            <!-- SPRING BOOT MAVEN PLUGIN -->
            <!-- ================================================= -->

            <plugin>

                <groupId>
                    org.springframework.boot
                </groupId>

                <artifactId>
                    spring-boot-maven-plugin
                </artifactId>


                <configuration>


                    <mainClass>
                        com.mycompany.ProyectoAplicacionesWeb.ProyectoAplicacionesWebApplication
                    </mainClass>


                    <!-- Lombok no se incluye en el JAR final -->

                    <excludes>

                        <exclude>

                            <groupId>
                                org.projectlombok
                            </groupId>

                            <artifactId>
                                lombok
                            </artifactId>

                        </exclude>

                    </excludes>


                </configuration>

            </plugin>


            <!-- ================================================= -->
            <!-- MAVEN COMPILER + LOMBOK -->
            <!-- ================================================= -->

            <plugin>

                <groupId>
                    org.apache.maven.plugins
                </groupId>

                <artifactId>
                    maven-compiler-plugin
                </artifactId>


                <configuration>

                    <!-- Compilar utilizando Java 21 -->

                    <release>
                        21
                    </release>


                    <!--
                        IMPORTANTE:
                        Ejecuta los procesadores de anotaciones.
                        Aquí es donde Lombok genera automáticamente:
                        getCorreo()
                        getIdVenta()
                        getProducto()
                        getCantidad()
                        etc.
                    -->

                    <proc>
                        full
                    </proc>


                    <!-- Procesador de anotaciones Lombok -->

                    <annotationProcessorPaths>

                        <path>

                            <groupId>
                                org.projectlombok
                            </groupId>

                            <artifactId>
                                lombok
                            </artifactId>

                        </path>

                    </annotationProcessorPaths>

                </configuration>


            </plugin>


        </plugins>

    </build>


</project>